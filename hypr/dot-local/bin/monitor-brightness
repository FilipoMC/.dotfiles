#!/usr/bin/env bash

exec 9>/tmp/monitor-brightness.lock
flock -w 3 9 || exit 0

read -r _ _ _ current max < <(ddcutil getvcp 10 -t)

if [[ -z "$current" || -z "$max" ]]; then
  exit 1
fi

increment=${2:-10}
((increment == 0)) && increment=10
vcp=${3:-10}

case "$1" in
up)
  new=$((current + increment))
  ddcutil setvcp "$vcp" "$((new > max ? max : new))"
  ;;
down)
  new=$((current - increment))
  ddcutil setvcp "$vcp" "$((new < 0 ? 0 : new))"
  ;;
max)
  ddcutil setvcp "$vcp" "$max"
  ;;
min)
  ddcutil setvcp "$vcp" 0
  ;;
esac
